{
  "name": "arrow-out-2",
  "main": "worker.js",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/arrows.json"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arrow-out-2",
      "database_id": "1b1daeda-199b-4a1e-8478-f9aad8401191",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    { "pattern": "arrow-out-2.staho.dev", "custom_domain": true }
  ]
}
